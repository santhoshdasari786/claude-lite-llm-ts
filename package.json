{
  "name": "@santhoshdasari/claude-lite-llm-ts",
  "version": "0.3.1",
  "description": "Programmatic Claude & Codex CLI wrapper for LiteLLM to use subscriptions without API keys",
  "keywords": [
    "typescript",
    "library",
    "utilities",
    "litellm"
  ],
  "license": "MIT",
  "author": "D S Santhosh <santhoshdasari786@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santhoshdasari786/claude-lite-llm-ts.git"
  },
  "bugs": {
    "url": "https://github.com/santhoshdasari786/claude-lite-llm-ts/issues"
  },
  "homepage": "https://github.com/santhoshdasari786/claude-lite-llm-ts#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "claude-lite-llm-ts": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
